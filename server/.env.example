# Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
# If left empty in development, an embedded in-memory MongoDB will be used automatically
MONGODB_URI=mongodb://127.0.0.1:27017/hardware_billing

# Security & JWT Configuration
JWT_ACCESS_SECRET=your_super_secret_access_key_min_32_characters_long_12345
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_characters_long_67890
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS Allowed Origin (Frontend URL)
CLIENT_URL=http://localhost:5173

# Cookie Security (set to true in production with HTTPS)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10
